{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DATABASE_CONNECTION_STRING_HERE"
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092"
  },
  "CacheSettings": {
    "RedisConnectionString": "localhost:6379",
    "InstanceName": "TransactionService:",
    "DefaultExpirationMinutes": 60
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5203"
      },
      "Grpc": {
        "Url": "http://localhost:5204"
      }
    }
  }
} 