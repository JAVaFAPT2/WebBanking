{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=db;Database=DD;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:80"
      },
      "Grpc": {
        "Url": "http://localhost:8081"
      }
    }
  },
  "NotificationService": {
    "DefaultRetryAttempts": 3,
    "DefaultRetryDelaySeconds": 5,
    "DefaultFromEmail": "noreply@examplebank.com",
    "DefaultFromName": "Example Bank Notifications",
    "DefaultSmsSenderId": "ExampleBank"
    // Add any provider-specific keys if needed, e.g., for SendGrid, Twilio, FCM
    // "Providers": {
    //   "SendGrid": {
    //     "ApiKey": "YOUR_SENDGRID_API_KEY"
    //   }
    // }
  },
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/WebBankingRealm",
    "ClientId": "notification-service",
    "Audience": "webbanking",
    "RequireHttpsMetadata": false
  }
} 