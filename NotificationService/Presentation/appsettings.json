{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Grpc": {
        "Url": "http://localhost:5002"
      }
    }
  },
  "NotificationService": {
    "DefaultRetryAttempts": 3,
    "DefaultRetryDelaySeconds": 5,
    "DefaultFromEmail": "noreply@examplebank.com",
    "DefaultFromName": "Example Bank Notifications",
    "DefaultSmsSenderId": "ExampleBank"
    // Add any provider-specific keys if needed, e.g., for SendGrid, Twilio, FCM
    // "Providers": {
    //   "SendGrid": {
    //     "ApiKey": "YOUR_SENDGRID_API_KEY"
    //   }
    // }
  }
} 