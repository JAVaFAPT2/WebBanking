{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=db;Database=DD;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "KafkaSettings": {
    "BootstrapServers": "kafka:9092"
  },
  "CacheSettings": {
    "RedisConnectionString": "redis:6379",
    "InstanceName": "TransactionService:",
    "DefaultExpirationMinutes": 60
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:80"
      },
      "Grpc": {
        "Url": "http://localhost:8081"
      }
    }
  },
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/WebBankingRealm",
    "ClientId": "transaction-service",
    "Audience": "webbanking",
    "RequireHttpsMetadata": false
  }
} 