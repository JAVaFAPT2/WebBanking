{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId",
      "WithCorrelationId"
    ]
  },
  "OpenTelemetry": {
    "ServiceName": "LoanService",
    "ServiceVersion": "1.0.0",
    "ActivitySourceName": "LoanService.Telemetry"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "Database": "Server=localhost;Database=LoanDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "LoanService": {
    "MaxLoanAmount": 1000000,
    "MinLoanAmount": 1000,
    "MaxTermMonths": 360,
    "MinTermMonths": 6
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "LoanService",
        "Uri": "http://localhost:5001/health"
      }
    ],
    "EvaluationTimeInSeconds": 10,
    "MinimumSecondsBetweenFailureNotifications": 60
  },
  "AllowedHosts": "*"
} 