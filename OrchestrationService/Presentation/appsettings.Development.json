    },
    "NotificationService": {
      "Url": "http://notification-service:80",
      "GrpcUrl": "http://notification-service:8081"
    },
    "CardService": {
      "Url": "http://card-service:80",
      "GrpcUrl": "http://card-service:8081"
    },
    "LoanService": {
      "Url": "http://loan-service:80",
      "GrpcUrl": "http://loan-service:8081"
    }
  },
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/WebBankingRealm",
    "ClientId": "orchestration",
    "Audience": "webbanking",
    "RequireHttpsMetadata": false
  }
