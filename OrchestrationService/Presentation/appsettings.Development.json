{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=db;Database=OrchestrationService_db;Uid=root;Pwd=root_password;"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092"
  },
  "Services": {
    "AccountService": {
