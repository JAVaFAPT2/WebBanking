{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "orchestration-service",
    "GroupId": "orchestration-service-group",
    "AccountCommandTopic": "account-commands",
    "AccountEventTopic": "account-events",
    "NotificationCommandTopic": "notification-commands",
    "NotificationEventTopic": "notification-events",
    "CardCommandTopic": "card-commands",
    "CardEventTopic": "card-events",
    "LoanCommandTopic": "loan-commands",
    "LoanEventTopic": "loan-events"
  },
  "Services": {
    "AccountService": {
      "Url": "http://account-service:8080",
      "GrpcUrl": "http://account-service:8081"
    },
    "NotificationService": {
      "Url": "http://notification-service:8080",
      "GrpcUrl": "http://notification-service:8081"
    },
    "CardService": {
      "Url": "http://card-service:8080",
      "GrpcUrl": "http://card-service:8081"
    },
    "LoanService": {
      "Url": "http://loan-service:8080",
      "GrpcUrl": "http://loan-service:8081"
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/your-realm",
    "Audience": "orchestration",
    "RequireHttpsMetadata": false
  }
}
